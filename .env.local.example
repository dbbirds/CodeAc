# Firebase Configuration
# Get these from Firebase Console > Project Settings > General > Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Resend API Key for email reminders
# Get this from resend.com (free tier: 100 emails/day)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Email address to send reminders from
# Must be a verified domain in Resend
RESEND_FROM_EMAIL=reminders@yourdomain.com

# Email addresses for you and Jenna
REMINDER_EMAIL_1=your@email.com
REMINDER_EMAIL_2=jenna@email.com

# Google Calendar Embed URL
# Go to Google Calendar > Settings > Integrate calendar > Embed code
# Extract the src URL from the iframe
NEXT_PUBLIC_GOOGLE_CALENDAR_EMBED_URL=https://calendar.google.com/calendar/embed?src=...
